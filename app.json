{
  "expo": {
    "name": "Mikana",
    "slug": "mikana-mobile",
    "version": "1.0.0",
    "scheme": "mikana",
    "orientation": "portrait",
    "icon": "./assets/ic_launcher.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0B2545",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikana.mikana",
      "icon": "./assets/ic_launcher.png"
    },
    "android": {
      "package": "com.mikana.mikana",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B2545",
        "foregroundImage": "./assets/ic_launcher_foreground.png",
        "backgroundImage": "./assets/ic_launcher_background.png",
        "monochromeImage": "./assets/ic_launcher_monochrome.png"
      },

      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font"
    ]
  }
}
